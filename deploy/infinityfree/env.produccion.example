# Variables de entorno de producción para InfinityFree.
# Copiar como htdocs/.env en el servidor y completar los valores vacíos.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://<dominio>
# Pegar el resultado de: php artisan key:generate --show
APP_KEY=
APP_LOCALE=es

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=sql106.infinityfree.com
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=15
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log

HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=10

MAIL_MAILER=failover
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

TAREAS_POR_PETICION=true

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
